---
/**
 * Button — Engineered Notch system (Button System v1.2)
 *
 * Variants:
 *   primary   — blue-500 notch fill (default)
 *   secondary — charcoal notch fill
 *   ghost     — plain text link
 *
 * Sizes:
 *   default   — 14px / 14px 26px padding
 *   lg        — 15px / 17px 30px padding
 *   sm        — 13px / 10px 18px padding
 *
 * Renders as <a> when href is provided, <button> otherwise.
 * The panel-spotlight light variant is automatic via CSS context.
 *
 * Usage:
 *   import Button from '../components/Button.astro';
 *   <Button href="/contact">Get a free assessment</Button>
 *   <Button variant="secondary" href="/work">See our work</Button>
 *   <Button variant="ghost" href="tel:4106457121">Call 410-645-7121</Button>
 *   <Button size="lg">Large CTA</Button>
 *   <Button size="sm">Small action</Button>
 *   <Button disabled>Unavailable</Button>
 */

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'lg';
  href?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  size,
  href,
  target,
  rel,
  type = 'button',
  disabled = false,
  class: className = '',
  ...rest
} = Astro.props;

const variantClass = {
  primary:   'btn-primary',
  secondary: 'btn-secondary',
  ghost:     'btn-ghost',
}[variant];

const sizeClass = size === 'lg' ? 'btn-lg' : size === 'sm' ? 'btn-sm' : '';
const classes   = [variantClass, sizeClass, className].filter(Boolean).join(' ');

const isLink = Boolean(href);
---

{isLink ? (
  <a
    class={classes}
    href={href}
    target={target}
    rel={rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined)}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button
    class={classes}
    type={type}
    disabled={disabled || undefined}
    {...rest}
  >
    <slot />
  </button>
)}

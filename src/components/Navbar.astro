---
const { pathname } = Astro.url;
const links = [
  { href: '/',           label: 'Home'       },
  { href: '/services',   label: 'Services'   },
  { href: '/government', label: 'Government' },
  { href: '/work',       label: 'Our Work'   },
  { href: '/about',      label: 'About'      },
  { href: '/contact',    label: 'Contact'    },
];
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header id="site-nav" class="nav-shell">

  <!-- Top gradient — legibility over hero video, scoped here -->
  <div class="nav-gradient" aria-hidden="true"></div>

  <div id="nav-bar" class="nav-bar">

    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="Trican Security">
      <svg width="20" height="22" viewBox="0 0 20 22" fill="none" aria-hidden="true">
        <path d="M10 1L1.5 4.8v5.6c0 4.9 3.6 9.5 8.5 10.6 4.9-1.1 8.5-5.7 8.5-10.6V4.8L10 1z"
          fill="rgba(0,153,255,0.1)" stroke="#0099ff" stroke-width="1.3" stroke-linejoin="round"/>
        <path d="M6.5 11l2.5 2.5L13.5 8.5"
          stroke="#0099ff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="logo-name">TRICAN</span>
      <span class="logo-sep" aria-hidden="true"></span>
      <span class="logo-type">SECURITY</span>
    </a>

    <!-- Desktop nav -->
    <nav class="nav-links" aria-label="Main">
      {links.map(l => (
        <a href={l.href} class={`nav-link${isActive(l.href) ? ' is-active' : ''}`}>
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Actions -->
    <div class="nav-actions">
      <a href="tel:4106457121" class="nav-phone" aria-label="Call us">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.91 19.79 19.79 0 01.01 1.27 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/>
        </svg>
        410-645-7121
      </a>

      <a href="/contact" class="nav-cta">
        <span>Free Assessment</span>
        <svg class="cta-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

      <button id="nav-toggle" class="nav-hamburger" aria-label="Open menu" aria-expanded="false">
        <span class="hb-line"></span>
        <span class="hb-line hb-line--mid"></span>
        <span class="hb-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-nav" class="mobile-drawer hidden">
    <nav class="mobile-links">
      {links.map(l => (
        <a href={l.href} class={`mobile-link${isActive(l.href) ? ' is-active' : ''}`}>
          <span>{l.label}</span>
          {isActive(l.href) && (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0099ff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          )}
        </a>
      ))}
    </nav>
    <div class="mobile-bottom">
      <a href="/contact" class="nav-cta mobile-cta">Free Assessment</a>
      <a href="tel:4106457121" class="mobile-tel">410-645-7121</a>
    </div>
  </div>

</header>

<style>
  /* ─────────────────────────────────────────────
     Shell
  ───────────────────────────────────────────── */
  .nav-shell {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    pointer-events: none;
  }

  /* Top gradient — only affects the nav zone */
  .nav-gradient {
    position: absolute;
    inset: 0 0 auto;
    height: 140px;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.72) 0%,
      rgba(0,0,0,0.30) 50%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* ─────────────────────────────────────────────
     Bar
  ───────────────────────────────────────────── */
  .nav-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 0 clamp(20px, 4vw, 60px);
    background: transparent;
    transition:
      background  0.4s cubic-bezier(.4,0,.2,1),
      box-shadow  0.4s cubic-bezier(.4,0,.2,1);
    pointer-events: all;
  }

  /* Scrolled — thin blue top accent + dark fill */
  .nav-shell.is-scrolled .nav-bar {
    background: #090909;
    box-shadow: 0 4px 28px rgba(0,0,0,0.55);
  }

  /* ─────────────────────────────────────────────
     Logo
  ───────────────────────────────────────────── */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-name {
    font-family: 'Saira', sans-serif;
    font-weight: 600;
    font-size: 14.5px;
    letter-spacing: 0.12em;
    color: #ffffff;
  }
  .logo-sep {
    width: 1px;
    height: 14px;
    background: rgba(255,255,255,0.18);
    flex-shrink: 0;
  }
  .logo-type {
    font-family: 'Saira', sans-serif;
    font-weight: 500;
    font-size: 14.5px;
    letter-spacing: 0.12em;
    color: #0099ff;
  }

  /* ─────────────────────────────────────────────
     Desktop nav links
  ───────────────────────────────────────────── */
  .nav-links {
    display: none;
    align-items: center;
    gap: 0;
  }
  @media (min-width: 1024px) { .nav-links { display: flex; } }

  .nav-link {
    position: relative;
    font-family: 'Exo 2', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255,255,255,0.48);
    padding: 6px 14px;
    transition: color 0.22s ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 14px;
    right: 14px;
    height: 1.5px;
    background: #0099ff;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.25s cubic-bezier(.4,0,.2,1);
  }
  .nav-link:hover {
    color: rgba(255,255,255,0.9);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }
  .nav-link.is-active {
    color: #ffffff;
  }
  .nav-link.is-active::after {
    transform: scaleX(1);
    opacity: 1;
  }

  /* ─────────────────────────────────────────────
     Right actions
  ───────────────────────────────────────────── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-phone {
    display: none;
    align-items: center;
    gap: 7px;
    font-family: 'Exo 2', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.35);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-phone:hover { color: rgba(255,255,255,0.7); }
  @media (min-width: 1280px) { .nav-phone { display: flex; } }

  /* CTA */
  .nav-cta {
    display: none;
    align-items: center;
    gap: 8px;
    font-family: 'Exo 2', sans-serif;
    font-weight: 700;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: #ffffff;
    background: #0099ff;
    padding: 9px 18px;
    border: none;
    clip-path: polygon(0 0, 100% 0, 100% 65%, 94% 100%, 0 100%);
    transition: background 0.2s ease;
    white-space: nowrap;
  }
  .nav-cta:hover { background: #0088ee; }
  .nav-cta:hover .cta-arrow { transform: translateX(3px); }
  .cta-arrow { transition: transform 0.2s ease; flex-shrink: 0; }
  @media (min-width: 1024px) { .nav-cta { display: inline-flex; } }

  /* Hamburger — 3 custom lines */
  .nav-hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    width: 34px;
    height: 34px;
  }
  @media (min-width: 1024px) { .nav-hamburger { display: none; } }

  .hb-line {
    display: block;
    height: 1.5px;
    background: rgba(255,255,255,0.65);
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.25s ease, width 0.25s ease;
    width: 22px;
  }
  .hb-line--mid { width: 16px; }

  .nav-hamburger[aria-expanded="true"] .hb-line:first-child {
    transform: translateY(6.5px) rotate(45deg);
    width: 22px;
  }
  .nav-hamburger[aria-expanded="true"] .hb-line--mid {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-hamburger[aria-expanded="true"] .hb-line:last-child {
    transform: translateY(-6.5px) rotate(-45deg);
    width: 22px;
  }

  /* ─────────────────────────────────────────────
     Mobile drawer
  ───────────────────────────────────────────── */
  .mobile-drawer {
    background: #090909;
    pointer-events: all;
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    padding: 6px clamp(20px, 4vw, 60px);
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: 'Exo 2', sans-serif;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.42);
    text-decoration: none;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    transition: color 0.2s;
  }
  .mobile-link:last-child { border-bottom: none; }
  .mobile-link:hover,
  .mobile-link.is-active { color: #ffffff; }

  .mobile-bottom {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px clamp(20px, 4vw, 60px) 20px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .mobile-cta {
    display: flex !important;
    justify-content: center;
    clip-path: none;
  }
  .mobile-tel {
    display: block;
    text-align: center;
    font-family: 'Exo 2', sans-serif;
    font-size: 12px;
    color: rgba(255,255,255,0.28);
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.2s;
  }
  .mobile-tel:hover { color: rgba(255,255,255,0.6); }
</style>

<script>
  const shell  = document.getElementById('site-nav')   as HTMLElement;
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement;
  const drawer = document.getElementById('mobile-nav') as HTMLElement;
  let open = false;

  function syncScroll() {
    shell.classList.toggle('is-scrolled', window.scrollY > 10);
  }
  window.addEventListener('scroll', syncScroll, { passive: true });
  syncScroll();

  toggle.addEventListener('click', () => {
    open = !open;
    drawer.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>

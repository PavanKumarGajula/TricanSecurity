---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoThumbs from '../components/VideoThumbs.tsx';
import StatIcons from '../components/StatIcons.tsx';

const services = [
  {
    title: 'Surveillance',
    icon: `<svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z"/></svg>`,
    body: 'Cameras chosen for your space, not off a shelf. Video analytics, license plate recognition, thermal and radar options, all viewable from your phone.',
    features: ['Auto tracking & heat mapping', 'License plate recognition', 'Audio analytics', 'Thermal & radar perimeter options', 'Remote viewing on any device'],
  },
  {
    title: 'Access Control',
    icon: `<svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"/></svg>`,
    body: 'Badge access, smart cards, biometrics, intercoms, and touch-free entry, with a log of every door event for review and audit.',
    features: ['Role-based badge permissions', 'Biometrics & two-factor auth', 'Touch-free & wave-to-open entry', 'Multi-tenant intercom systems', 'FIPS 201 / PIV certified'],
  },
  {
    title: 'Alarms & Fire',
    icon: `<svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>`,
    body: 'Intrusion detection with video-verified alarms and 24/7 monitoring, plus fire alarm systems handled by NICET-certified technicians.',
    features: ['Video-verified alarms', '24/7 monitoring & incident response', 'Mobile arm/disarm via Alarm.com', 'NICET fire alarm design & install', 'Personal emergency response systems'],
  },
];

---

<BaseLayout
  title="Trican Security Inc. — Maryland Security Systems"
  description="Trican Security is a locally owned Maryland integrator serving businesses and government agencies across the state, the Baltimore–Washington corridor, and Virginia."
  padTop={false}
>

  <!-- ── Hero ── -->
  <section class="vhero">

    <video id="vhero-bg-vid" class="vhero-video" src="/videos/evangel.mp4" autoplay muted loop playsinline preload="metadata" poster="/images/evangel-poster.jpg" aria-hidden="true"></video>
    <div class="vhero-overlay" aria-hidden="true"></div>

    <!-- Full-height flex column wrapper — the MCP pattern -->
    <div class="vhero-wrap">

      <!-- flex:1 center zone -->
      <div class="vhero-inner">
        <div class="vhero-content">

          <div class="vhero-eyebrow">
            <span class="vhero-dot dot-pulse-green" aria-hidden="true"></span>
            <span class="vhero-eyebrow-text">Maryland's Trusted Security Integrator</span>
          </div>

          <h1 class="hero-headline vhero-h1">Protecting what<br/>matters most.</h1>

          <p class="vhero-body">Locally owned. Government-certified. Serving businesses and agencies across Maryland, Baltimore–Washington, and Virginia.</p>

          <div class="vhero-ctas">
            <a href="/contact" class="vhero-cta-primary">
              Get a free assessment
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/work" class="vhero-cta-ghost">See our work</a>
          </div>

          <div class="vhero-proof">
            <div class="vhero-badges">
              <span class="vhero-badge">MBE Certified</span>
              <span class="vhero-badge">NICET Fire</span>
              <span class="vhero-badge">FIPS 201</span>
            </div>
            <span class="vhero-proof-sep" aria-hidden="true"></span>
            <p class="vhero-proof-text">Licensed &amp; insured · MD, DC &amp; VA</p>
          </div>

        </div>
      </div>

      <!-- Bottom row — natural flow at bottom of flex column -->
      <div class="vhero-bottom">
        <div class="vhero-bottom-left">
          <p class="vhero-tagline">Every layer of protection. One team.</p>
        </div>
        <VideoThumbs client:load className="vhero-thumbs-cards" />
      </div>

    </div>

  </section>

  <!-- ── What We Do ── -->
  <section class="bg-canvas wwd-band">
    <div class="page-container">

      <div class="wwd-head fade-up">
        <p class="eyebrow">What we do</p>
        <h2 class="wwd-h2">Every layer, designed to work together.</h2>
      </div>

      <div class="wwd-timeline fade-up">
        <span class="wwd-t-dot"></span>
        <span class="wwd-t-line"></span>
        <span class="wwd-t-lbl">Every layer of protection</span>
        <span class="wwd-t-dot"></span>
        <span class="wwd-t-line"></span>
        <span class="wwd-t-lbl">One team</span>
        <span class="wwd-t-dot"></span>
      </div>

      <div class="wwd-row-clip">
        <div class="wwd-cards">

          <div class="wwd-card-wrap">
            <span class="wwd-conn" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h3l2-5 3 10 2-5h6"/></svg></span>
            <a class="wwd-card wwd-c-surv fade-up" href="/services#surveillance">
              <div class="wwd-card-img-wrap">
                <img src="/images/wwd-surveillance.jpg" alt="" class="wwd-card-img" />
              </div>
              <div class="wwd-card-body">
                <div class="wwd-card-header">
                  <span class="wwd-icon-circle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="13" height="9" rx="2"/><path d="M15 9l7-3v9l-7-3"/><circle cx="7" cy="10.5" r="1.6"/></svg></span>
                  <p class="wwd-card-title">Surveillance</p>
                </div>
                <p class="wwd-card-sub">Cameras chosen for your space</p>
                <p class="wwd-card-desc">Video analytics, license plate recognition, thermal and radar options, all viewable from your phone.</p>
              </div>
            </a>
          </div>

          <div class="wwd-card-wrap">
            <span class="wwd-conn" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h3l2-5 3 10 2-5h6"/></svg></span>
            <a class="wwd-card wwd-c-access fade-up" href="/services#access-control">
              <div class="wwd-card-img-wrap">
                <img src="/images/wwd-access.png" alt="" class="wwd-card-img wwd-card-img--contain" />
              </div>
              <div class="wwd-card-body">
                <div class="wwd-card-header">
                  <span class="wwd-icon-circle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="12" height="18" rx="2"/><circle cx="10" cy="9" r="2.4"/><path d="M7 17c.6-2 5.4-2 6 0"/><path d="M20 9v6"/></svg></span>
                  <p class="wwd-card-title">Access control</p>
                </div>
                <p class="wwd-card-sub">The right people in</p>
                <p class="wwd-card-desc">Badge access, smart cards, biometrics, intercoms, and touch-free entry, with a log of every door event.</p>
              </div>
            </a>
          </div>

          <div class="wwd-card-wrap">
            <span class="wwd-conn" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h3l2-5 3 10 2-5h6"/></svg></span>
            <a class="wwd-card wwd-c-fire fade-up" href="/services#alarms">
              <div class="wwd-card-img-wrap">
                <img src="/images/wwd-fire.png" alt="" class="wwd-card-img wwd-card-img--contain" />
              </div>
              <div class="wwd-card-body">
                <div class="wwd-card-header">
                  <span class="wwd-icon-circle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 16H3z"/><path d="M12 10v4"/><circle cx="12" cy="16.6" r=".6"/></svg></span>
                  <p class="wwd-card-title">Alarms &amp; fire</p>
                </div>
                <p class="wwd-card-sub">Protection around the clock</p>
                <p class="wwd-card-desc">Intrusion detection with video-verified alarms and 24/7 monitoring, plus NICET-certified fire alarm systems.</p>
              </div>
            </a>
          </div>

          <div class="wwd-card-wrap">
            <span class="wwd-conn" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h3l2-5 3 10 2-5h6"/></svg></span>
            <a class="wwd-card wwd-c-network fade-up" href="/services#network">
              <div class="wwd-card-img-wrap">
                <img src="/images/panel.png" alt="" class="wwd-card-img wwd-card-img--contain" />
              </div>
              <div class="wwd-card-body">
                <div class="wwd-card-header">
                  <span class="wwd-icon-circle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><circle cx="7" cy="7.5" r=".7"/><circle cx="7" cy="16.5" r=".7"/></svg></span>
                  <p class="wwd-card-title">Network &amp; cabling</p>
                </div>
                <p class="wwd-card-sub">The backbone behind every system</p>
                <p class="wwd-card-desc">Every camera, badge reader, and alarm panel runs on your network, so we build that too: structured cabling, racks, and WiFi.</p>
              </div>
            </a>
          </div>

          <div class="wwd-card-wrap">
            <span class="wwd-conn" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h3l2-5 3 10 2-5h6"/></svg></span>
            <a class="wwd-card wwd-c-rentals fade-up" href="/services#rentals">
              <div class="wwd-card-img-wrap">
                <img src="/images/mobile_surveillance.png" alt="" class="wwd-card-img wwd-card-img--contain" />
              </div>
              <div class="wwd-card-body">
                <div class="wwd-card-header">
                  <span class="wwd-icon-circle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="15" height="9" rx="1.5"/><circle cx="7" cy="18.5" r="1.8"/><circle cx="14" cy="18.5" r="1.8"/><path d="M17 11h5"/></svg></span>
                  <p class="wwd-card-title">Trailer rentals</p>
                </div>
                <p class="wwd-card-sub">Deployed in 10 minutes</p>
                <p class="wwd-card-desc">Rugged, solar powered, and self contained, with live streaming over cellular. Short and long term rentals.</p>
              </div>
            </a>
          </div>

          <div class="wwd-card-wrap">
            <a class="wwd-card wwd-c-pers fade-up" href="/services#emergency">
              <div class="wwd-card-img-wrap">
                <img src="/images/wearable_pendant.png" alt="" class="wwd-card-img wwd-card-img--contain" />
              </div>
              <div class="wwd-card-body">
                <div class="wwd-card-header">
                  <span class="wwd-icon-circle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5 20c.8-4 13.2-4 14 0"/><path d="M19 4l2 2M21 4l-2 2"/></svg></span>
                  <p class="wwd-card-title">Emergency response</p>
                </div>
                <p class="wwd-card-sub">Protecting people in the field</p>
                <p class="wwd-card-desc">Personal emergency response with two-way voice and GPS, proven protecting Queen Anne's County health workers.</p>
              </div>
            </a>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- ── Why Trican ── -->
  <section class="bg-canvas why-band">
    <div class="page-container">
      <div class="why-grid">

        <!-- BADGE — row 1, col 1 -->
        <div class="why-area-badge fade-up">
          <span class="why-badge">
            <span class="why-badge-dot"></span>Why Trican
          </span>
        </div>

        <!-- HEADLINE — spans cols 1–2, row 2 -->
        <h2 class="why-area-head fade-up">
          One client saved over <span class="why-stat">$30,000</span> vs. the national companies.
        </h2>

        <!-- WIDGET — col 1, row 3, anchored to bottom -->
        <div class="why-area-widget fade-up">
          <div class="why-widget">
            <p class="why-widget-lbl">System status</p>
            <p class="why-widget-val">
              <span class="why-widget-dot"></span>Armed
            </p>
            <div class="why-testimonial">
              <div class="why-stars" aria-label="5 out of 5 stars">
                <svg viewBox="0 0 16 16" fill="#f59e0b" aria-hidden="true"><path d="M8 1l1.85 3.75L14 5.5l-3 2.92.71 4.13L8 10.5l-3.71 1.95.71-4.13L2 5.5l4.15-.75L8 1z"/></svg>
                <svg viewBox="0 0 16 16" fill="#f59e0b" aria-hidden="true"><path d="M8 1l1.85 3.75L14 5.5l-3 2.92.71 4.13L8 10.5l-3.71 1.95.71-4.13L2 5.5l4.15-.75L8 1z"/></svg>
                <svg viewBox="0 0 16 16" fill="#f59e0b" aria-hidden="true"><path d="M8 1l1.85 3.75L14 5.5l-3 2.92.71 4.13L8 10.5l-3.71 1.95.71-4.13L2 5.5l4.15-.75L8 1z"/></svg>
                <svg viewBox="0 0 16 16" fill="#f59e0b" aria-hidden="true"><path d="M8 1l1.85 3.75L14 5.5l-3 2.92.71 4.13L8 10.5l-3.71 1.95.71-4.13L2 5.5l4.15-.75L8 1z"/></svg>
                <svg viewBox="0 0 16 16" fill="#f59e0b" aria-hidden="true"><path d="M8 1l1.85 3.75L14 5.5l-3 2.92.71 4.13L8 10.5l-3.71 1.95.71-4.13L2 5.5l4.15-.75L8 1z"/></svg>
              </div>
              <blockquote class="why-quote">"They came in, listened to what we actually needed, and delivered exactly that — cleaner install, better coverage, under budget."</blockquote>
              <div class="why-quote-author">
                <span class="why-quote-avatar">JM</span>
                <div>
                  <p class="why-quote-name">J. Morris</p>
                  <p class="why-quote-role">Operations Manager, RDC</p>
                </div>
              </div>
            </div>
            <div class="why-widget-row">
              <span class="why-widget-lbl">Monitoring &amp; response</span>
              <span class="why-widget-num">24/7</span>
            </div>
          </div>
        </div>

        <!-- COL 2 — col 2, row 3 -->
        <div class="why-col-mid fade-up">
          <p class="why-body">That client also ended up with more features than before. Our model is simple: we listen first, then design around the risks a site actually has. If a piece of equipment won't earn its keep, it doesn't go in the quote.</p>
          <div class="why-cta-row">
            <a href="/contact" class="why-pill">Get a free assessment</a>
            <a href="/contact" class="why-circle" aria-label="Get a free assessment">↗</a>
          </div>
          <hr class="why-hr" />
          <div class="why-feature">
            <span class="why-feat-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="8" y="14" width="24" height="24" rx="3"/><rect x="16" y="8" width="24" height="24" rx="3"/>
              </svg>
            </span>
            <div>
              <h3 class="why-feat-title">One team, end to end</h3>
              <p class="why-feat-desc">Installers and software engineers together — most installers stop where the wiring ends. We don't.</p>
            </div>
          </div>
          <div class="why-feature">
            <span class="why-feat-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="10" y="10" width="28" height="28" rx="3" transform="rotate(45 24 24)"/><circle cx="24" cy="24" r="3"/>
              </svg>
            </span>
            <div>
              <h3 class="why-feat-title">Built around your budget</h3>
              <p class="why-feat-desc">We design around your objectives and your budget — then we stand behind the work.</p>
            </div>
          </div>
        </div>

        <!-- COL 3 — photo spans all rows -->
        <div class="why-col-photo fade-up">
          <div class="why-photo">
            <img src="/images/wwd-surveillance.jpg" alt="Trican security installation" class="why-photo-img" />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Stats ── -->
  <section class="bg-canvas py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <StatIcons client:load />
    </div>
  </section>

  <!-- ── Featured Project ── -->
  <section class="bg-canvas fp-band">
    <div class="page-container">

      <div class="fp-head fade-up">
        <div class="fp-head-text">
          <p class="eyebrow">Featured project</p>
          <h2 class="fp-h2">One campus, every layer<br>working as one.</h2>
          <p class="fp-head-body">A 100,000 sq ft cathedral and outlying buildings — Evangel Cathedral, Maryland. Six systems Trican designed, installed, and integrated into one.</p>
        </div>
        <a class="fp-pill" href="/work">See more of our work <span aria-hidden="true">↗</span></a>
      </div>

      <div class="fp-stage">

        <!-- LEFT CALLOUTS -->
        <div class="fp-col fp-col-left">
          <div class="fp-callout fade-up">
            <h3 class="fp-callout-h">Smart card access</h3>
            <p class="fp-callout-p">Role-based credentials across the campus, fully integrated with the camera system.</p>
          </div>
          <div class="fp-callout fade-up">
            <h3 class="fp-callout-h">Video surveillance</h3>
            <p class="fp-callout-p">Coverage of the 100,000 sq ft cathedral and its outlying buildings.</p>
          </div>
          <div class="fp-callout fade-up">
            <h3 class="fp-callout-h">Audio analytics</h3>
            <p class="fp-callout-p">Sound-event detection layered on top of the video system.</p>
          </div>
        </div>

        <!-- PHONE MOCKUP -->
        <div class="fp-phone-col fade-up">
          <div class="fp-phone">
            <span class="fp-notch" aria-hidden="true"></span>
            <div class="fp-screen">
              <div class="fp-app">

                <div class="fp-app-top">
                  <span class="fp-brand">
                    <span class="fp-mark">T</span>
                    <span class="fp-brand-name">Trican</span>
                  </span>
                  <span class="fp-live">
                    <i class="fp-rec-dot"></i>Live
                  </span>
                </div>

                <h4 class="fp-app-title">Evangel Cathedral</h4>
                <p class="fp-app-meta">Live site overview · demo</p>

                <div class="fp-armed">
                  <span class="fp-armed-dot"></span>
                  <span class="fp-armed-text">All zones armed</span>
                </div>

                <div class="fp-cams">
                  <div class="fp-cam"><span class="fp-rec"><i></i>Rec</span><span class="fp-cam-name">Sanctuary</span></div>
                  <div class="fp-cam"><span class="fp-rec"><i></i>Rec</span><span class="fp-cam-name">Lobby</span></div>
                  <div class="fp-cam"><span class="fp-rec"><i></i>Rec</span><span class="fp-cam-name">East lot</span></div>
                  <div class="fp-cam"><span class="fp-rec"><i></i>Rec</span><span class="fp-cam-name">Hall B</span></div>
                </div>

                <p class="fp-log-h">Access events</p>
                <div class="fp-ev"><span class="fp-ev-who">Staff badge</span><span class="fp-ev-door">Main entry</span><span class="fp-tag fp-granted">Granted</span></div>
                <div class="fp-ev"><span class="fp-ev-who">Service</span><span class="fp-ev-door">Hall B</span><span class="fp-tag fp-granted">Granted</span></div>
                <div class="fp-ev"><span class="fp-ev-who">Unknown</span><span class="fp-ev-door">East door</span><span class="fp-tag fp-denied">Denied</span></div>

              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT CALLOUTS -->
        <div class="fp-col fp-col-right">
          <div class="fp-callout fade-up">
            <h3 class="fp-callout-h">Lockdown capability</h3>
            <p class="fp-callout-p">One action secures every controlled door across the property.</p>
          </div>
          <div class="fp-callout fade-up">
            <h3 class="fp-callout-h">Auto-open schedules</h3>
            <p class="fp-callout-p">Doors follow the weekly service calendar without staff intervention.</p>
          </div>
          <div class="fp-callout fade-up">
            <h3 class="fp-callout-h">Two-factor entry</h3>
            <p class="fp-callout-p">High-security authentication for sensitive areas.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Footer CTA Band ── -->
  <section class="bg-canvas py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center fade-up">
      <h2 class="font-display font-semibold text-3xl lg:text-4xl text-ink tracking-tight max-w-2xl mx-auto mb-6">
        Not sure what you need? That's normal.
      </h2>
      <p class="font-body text-ink-muted max-w-lg mx-auto leading-relaxed mb-10">
        Call 410-645-7121 and we'll walk the property with you, then put together options that fit your budget. No pressure.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="btn-primary">Schedule a Site Walk</a>
        <a href="tel:4106457121" class="btn-ghost">Call 410-645-7121</a>
      </div>
    </div>
  </section>


  <style is:global>

    /* ══════════════════════════════════════════
       VIDEO HERO — exact viewport fit
    ══════════════════════════════════════════ */
    .vhero {
      position: relative;
      height: 100vh;
      min-height: 600px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: #060606;
    }


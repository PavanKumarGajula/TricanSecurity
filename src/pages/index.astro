  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const band  = document.querySelector<HTMLElement>('.wwd-band');
    const clip  = document.querySelector<HTMLElement>('.wwd-row-clip');
    const cards = document.querySelector<HTMLElement>('.wwd-cards');

    if (
      band && clip && cards &&
      window.matchMedia('(min-width: 768px)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      const getX = () => -(cards.scrollWidth - clip.offsetWidth);

      gsap.to(cards, {
        x: getX,
        ease: 'none',
        scrollTrigger: {
          trigger: band,
          start: 'top top',
          end: () => `+=${Math.abs(getX())}`,
          pin: true,
          scrub: 1,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });
    }
  </script>

</BaseLayout>

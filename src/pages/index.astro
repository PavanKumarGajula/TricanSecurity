      min-height: 480px;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.06), 0 14px 34px rgba(0,0,0,.30);
    }
    .why-photo-img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }

    @media (max-width: 1020px) {
      .why-grid {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto auto auto auto;
      }
      .why-area-head { grid-column: 1 / -1; }
      .why-col-photo { grid-column: 1 / -1; grid-row: 4; margin-top: 48px; }
      .why-photo { min-height: 360px; }
    }
    @media (max-width: 680px) {
      .why-grid { grid-template-columns: 1fr; }
      .why-area-head, .why-col-photo { grid-column: 1; }
      .why-area-widget { margin-bottom: 44px; }
    }

    /* ── Featured Project ── */
    .fp-band { padding: 80px 0 96px; }

    /* Head */
    .fp-head {
      display: flex; align-items: flex-end; justify-content: space-between;
      gap: 32px; margin-bottom: 56px;
    }
    .fp-head-text { max-width: 600px; }
    .fp-h2 {
      font-family: var(--font-display); font-weight: 600;
      font-size: clamp(28px, 3.8vw, 44px); letter-spacing: -1px; line-height: 1.16;
      color: var(--color-ink); margin-bottom: 14px;
    }
    .fp-head-body {
      font-family: var(--font-body); font-size: 15px; line-height: 1.65;
      color: var(--color-ink-muted); max-width: 520px;
    }
    .fp-pill {
      flex: none; display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--font-body); font-weight: 500; font-size: 14px;
      padding: 13px 24px; border-radius: 100px;
      background: var(--color-surface-1); color: var(--color-ink);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.06);
      text-decoration: none;
      transition: background var(--duration-card) ease, transform .12s ease;
    }
    .fp-pill:hover  { background: var(--color-surface-2); }
    .fp-pill:active { transform: scale(.97); }
    .fp-pill:focus-visible { outline: none; box-shadow: var(--shadow-focus); }
    @media (max-width: 720px) { .fp-head { flex-direction: column; align-items: flex-start; } }

    /* Stage grid */
    .fp-stage {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 28px; align-items: center;
    }

    /* Callout columns */
    .fp-col { display: flex; flex-direction: column; gap: 24px; }
    .fp-callout {
      position: relative;
      background: var(--color-surface-1); border-radius: 14px; padding: 20px 22px;
      box-shadow: var(--shadow-card);
    }
    .fp-callout-h {
      font-family: var(--font-display); font-weight: 600;
      font-size: 16px; letter-spacing: -.3px; color: var(--color-ink); margin-bottom: 6px;
    }
    .fp-callout-p { font-family: var(--font-body); font-size: 13px; line-height: 1.55; color: var(--color-ink-muted); }

    /* Dashed connectors */
    .fp-col-left  .fp-callout::before,
    .fp-col-right .fp-callout::before {
      content: ""; position: absolute; top: 50%; width: 40px;
      border-top: 1px dashed var(--color-fp-connector);
    }
    .fp-col-left  .fp-callout::before { right: -40px; }
    .fp-col-right .fp-callout::before { left:  -40px; }

    /* Phone */
    .fp-phone-col { display: flex; justify-content: center; }
    .fp-phone {
      width: 290px; border-radius: 44px; padding: 10px;
      background: var(--color-surface-2);
      box-shadow: var(--shadow-phone);
      position: relative;
    }
    .fp-notch {
      position: absolute; top: 18px; left: 50%; transform: translateX(-50%);
      width: 96px; height: 22px;
      background: var(--color-on-primary); border-radius: 100px; z-index: 3;
    }
    .fp-screen {
      border-radius: 36px; background: var(--color-app-bg);
      overflow: hidden; box-shadow: inset 0 0 0 1px var(--color-app-border);
    }
    .fp-app { padding: 38px 16px 18px; }

    /* App header */
    .fp-app-top { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; }
    .fp-brand   { display: flex; align-items: center; gap: 7px; margin-right: auto; }
    .fp-mark {
      width: 20px; height: 20px; border-radius: 5px;
      background: var(--color-blue-500); color: var(--color-ink);
      font-family: var(--font-display); font-weight: 600; font-size: 11px;
      display: flex; align-items: center; justify-content: center;
    }
    .fp-brand-name {
      font-family: var(--font-display); font-weight: 600; font-size: 13px;
      letter-spacing: 1px; text-transform: uppercase; color: var(--color-app-ink);
    }
    .fp-live {
      font-family: var(--font-body); font-weight: 600; font-size: 9px;
      letter-spacing: 1px; text-transform: uppercase; color: var(--color-app-ink-sub);
      display: flex; align-items: center; gap: 5px;
    }
    .fp-rec-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--color-error-500); display: inline-block;
      animation: fp-blink 1.4s steps(1) infinite;
    }
    @keyframes fp-blink { 50% { opacity: .22; } }

    .fp-app-title { font-family: var(--font-display); font-weight: 600; font-size: 17px; letter-spacing: -.3px; color: var(--color-app-ink); }
    .fp-app-meta  { font-family: var(--font-body); font-weight: 600; font-size: 9.5px; letter-spacing: 1px; text-transform: uppercase; color: var(--color-app-ink-sub); margin: 3px 0 14px; }

    .fp-armed {
      display: flex; align-items: center; gap: 8px;
      background: var(--color-app-armed-bg);
      box-shadow: inset 0 0 0 1px var(--color-app-armed-ring);
      border-radius: 10px; padding: 9px 12px; margin-bottom: 12px;
    }
    .fp-armed-dot  { width: 8px; height: 8px; border-radius: 50%; background: var(--color-success-500); flex-shrink: 0; }
    .fp-armed-text { font-family: var(--font-body); font-weight: 600; font-size: 10.5px; letter-spacing: 1px; text-transform: uppercase; color: var(--color-success-700); }

    .fp-cams { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 14px; }
    .fp-cam  { aspect-ratio: 16/10; background: var(--color-app-surface); border-radius: 9px; position: relative; box-shadow: inset 0 0 0 1px var(--color-app-border); }
    .fp-rec  { position: absolute; top: 6px; left: 7px; display: flex; align-items: center; gap: 4px; font-family: var(--font-body); font-weight: 600; font-size: 7px; letter-spacing: .5px; text-transform: uppercase; color: var(--color-app-ink-dim); }
    .fp-rec i { width: 5px; height: 5px; border-radius: 50%; background: var(--color-error-500); display: inline-block; }
    .fp-cam-name { position: absolute; bottom: 6px; left: 7px; font-family: var(--font-body); font-weight: 600; font-size: 7px; letter-spacing: .5px; text-transform: uppercase; color: var(--color-app-ink-dim); }

    .fp-log-h { font-family: var(--font-body); font-weight: 600; font-size: 9px; letter-spacing: 1px; text-transform: uppercase; color: var(--color-app-ink-dim); margin-bottom: 8px; }
    .fp-ev    { display: flex; align-items: center; gap: 8px; padding: 7px 0; border-top: 1px solid var(--color-app-divider); font-size: 11px; }
    .fp-ev-who  { font-family: var(--font-body); font-weight: 500; color: var(--color-app-ink); margin-right: auto; }
    .fp-ev-door { font-family: var(--font-body); font-size: 10px; color: var(--color-app-ink-sub); }
    .fp-tag { font-family: var(--font-body); font-weight: 600; font-size: 8.5px; letter-spacing: .5px; text-transform: uppercase; border-radius: 100px; padding: 3px 8px; }
    .fp-granted { color: var(--color-success-700); background: var(--color-app-granted-bg); }
    .fp-denied  { color: var(--color-error-700);   background: var(--color-app-denied-bg); }

    /* Responsive */
    @media (max-width: 920px) {
      .fp-stage { grid-template-columns: 1fr; gap: 32px; }
      .fp-col   { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .fp-col-left  .fp-callout::before,
      .fp-col-right .fp-callout::before { display: none; }
    }
    @media (max-width: 520px) {
      .fp-col { grid-template-columns: 1fr; }
    }

  </style>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const band  = document.querySelector<HTMLElement>('.wwd-band');
    const clip  = document.querySelector<HTMLElement>('.wwd-row-clip');
    const cards = document.querySelector<HTMLElement>('.wwd-cards');

    if (
      band && clip && cards &&
      window.matchMedia('(min-width: 768px)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      const getX = () => -(cards.scrollWidth - clip.offsetWidth);

      gsap.to(cards, {
        x: getX,
        ease: 'none',
        scrollTrigger: {
          trigger: band,
          start: 'top top',
          end: () => `+=${Math.abs(getX())}`,
          pin: true,
          scrub: 1,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });
    }
  </script>

</BaseLayout>

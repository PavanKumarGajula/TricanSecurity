---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Security Services — Trican Security Inc."
  description="Surveillance, access control, alarms, fire alarms, network infrastructure, and mobile trailer rentals for businesses and government agencies across Maryland."
  padTop={false}
>

  <!-- ── Hero ── -->
  <section class="svc-hero">

    <div class="svc-hero-content">
      <span class="svc-kicker">
        <span class="svc-kicker-dot" aria-hidden="true"></span>
        Every layer of protection. One team.
        <span class="svc-kicker-dot" aria-hidden="true"></span>
      </span>
      <h1 class="svc-hero-h1">Cameras, badges, alarms, fire, network. One team builds it all.</h1>
      <p class="svc-hero-sub"><b>Locally owned and Maryland-based.</b> One team for surveillance, access, alarms, fire, and network — across Maryland, the Baltimore–Washington corridor, and Virginia.</p>
      <div class="svc-hero-actions">
        <a class="btn-primary" href="/contact">Get a Free Assessment</a>
        <a class="btn-ghost" href="tel:4106457121">Call 410-645-7121</a>
      </div>
    </div>

    <div class="svc-strip-wrap">
      <div class="svc-strip-label">
        <span class="svc-strip-ln" aria-hidden="true"></span>
        <span class="svc-strip-t">Selected work · Maryland &amp; the DC region</span>
        <span class="svc-strip-ln" aria-hidden="true"></span>
      </div>
      <div class="svc-strip" aria-hidden="true">
        <div class="svc-track">
          <!-- set 1 -->
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/wwd-surveillance.jpg" alt="" class="svc-wimg" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Evangel Cathedral · Smart card + video</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/wearable_pendant.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Queen Anne's County · Mobile health units</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/network-hero.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">ReLink Medical · Network buildout</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/mobile_surveillance.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Mobile surveillance trailer</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/wwd-access.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Badge access &amp; smart cards</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/alarm-hero.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Fire alarm systems · NICET certified</span></div>
          </div>
          <!-- set 2 (duplicate for seamless loop) -->
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/wwd-surveillance.jpg" alt="" class="svc-wimg" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Evangel Cathedral · Smart card + video</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/wearable_pendant.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Queen Anne's County · Mobile health units</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/network-hero.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">ReLink Medical · Network buildout</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/mobile_surveillance.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Mobile surveillance trailer</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/wwd-access.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Badge access &amp; smart cards</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/alarm-hero.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Fire alarm systems · NICET certified</span></div>
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- ── Sticky Services Nav ── -->
  <nav class="svc-nav" id="svc-nav" aria-label="Jump to service">
    <div class="svc-nav-inner">
      <a href="#surveillance"  class="svc-nav-link" data-target="surveillance">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="13" height="9" rx="2"/><path d="M15 9l7-3v9l-7-3"/></svg>
        Surveillance
      </a>
      <span class="svc-nav-sep" aria-hidden="true"></span>
      <a href="#access-control" class="svc-nav-link" data-target="access-control">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="12" height="18" rx="2"/><circle cx="10" cy="9" r="2"/><path d="M7 17c.6-2 5.4-2 6 0"/></svg>
        Access Control
      </a>
      <span class="svc-nav-sep" aria-hidden="true"></span>
      <a href="#alarms" class="svc-nav-link" data-target="alarms">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        Alarms &amp; Fire
      </a>
      <span class="svc-nav-sep" aria-hidden="true"></span>
      <a href="#network" class="svc-nav-link" data-target="network">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><circle cx="7" cy="7.5" r=".7"/><circle cx="7" cy="16.5" r=".7"/></svg>
        Network
      </a>
      <span class="svc-nav-sep" aria-hidden="true"></span>
      <a href="#rentals" class="svc-nav-link" data-target="rentals">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="15" height="9" rx="1.5"/><circle cx="7" cy="18.5" r="1.8"/><circle cx="14" cy="18.5" r="1.8"/><path d="M17 11h5"/></svg>
        Commercial &amp; Rentals
      </a>
    </div>
  </nav>


  <!-- ── 01 Surveillance ── -->
  <section id="surveillance" class="svc-section svc-surv">
    <div class="svc-num" aria-hidden="true">01</div>
    <div class="page-container">

      <div class="bn-head fade-up">
        <div class="bn-head-left">
          <span class="bn-pill bn-pill--surv">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="13" height="9" rx="2"/><path d="M15 9l7-3v9l-7-3"/></svg>
            Surveillance
          </span>
          <h2 class="bn-h2">See everything that matters. From anywhere.</h2>
        </div>
        <p class="bn-sub">We design every camera system from scratch, then layer on analytics that turn footage into answers — all viewable from your phone or any computer.</p>
      </div>

      <div class="bn-grid fade-up">

        <!-- wide: camera systems -->
        <div class="bn-card bn-w2">
          <div class="bn-visual">
            <img src="/images/services/cameras.png" alt="Camera systems" class="bn-img" />
            <span class="bn-vfc bn-vfc-a"></span><span class="bn-vfc bn-vfc-b"></span>
          </div>
          <div class="bn-body">
            <h3 class="bn-title">Camera systems</h3>
            <p class="bn-desc">Network, analog, thermal, radar, and discreet domes — chosen for your space, not off a shelf.</p>
          </div>
        </div>

        <!-- narrow: auto tracking -->
        <div class="bn-card">
          <div class="bn-visual">
            <img src="/images/services/Auto_tracking.png" alt="Auto tracking" class="bn-img" />
            <span class="bn-vfc bn-vfc-a"></span><span class="bn-vfc bn-vfc-b"></span>
          </div>
          <div class="bn-body">
            <h3 class="bn-title">Auto tracking</h3>
            <p class="bn-desc">Cameras that follow movement across open spaces and parking lots.</p>
          </div>
        </div>

        <!-- narrow: heat mapping -->
        <div class="bn-card">
          <div class="bn-visual">
            <img src="/images/services/Heat_mapping.png" alt="Heat mapping" class="bn-img" />
            <span class="bn-vfc bn-vfc-a"></span><span class="bn-vfc bn-vfc-b"></span>
          </div>
          <div class="bn-body">
            <h3 class="bn-title">Heat mapping</h3>
            <p class="bn-desc">Traffic patterns by visitor density and duration.</p>
          </div>
        </div>

        <!-- narrow: people counting -->
        <div class="bn-card">
          <div class="bn-visual">
            <img src="/images/services/people_count.png" alt="People counting" class="bn-img" />
            <span class="bn-vfc bn-vfc-a"></span><span class="bn-vfc bn-vfc-b"></span>
          </div>
          <div class="bn-body">
            <h3 class="bn-title">People counting</h3>
            <p class="bn-desc">Know exactly how many enter and exit any defined area.</p>
          </div>
        </div>

        <!-- narrow: license plate -->
        <div class="bn-card">
          <div class="bn-visual">
            <img src="/images/services/Licenseplate.png" alt="License plate recognition" class="bn-img" />
            <span class="bn-vfc bn-vfc-a"></span><span class="bn-vfc bn-vfc-b"></span>
          </div>
          <div class="bn-body">
            <h3 class="bn-title">License plate recognition</h3>
            <p class="bn-desc">Searchable plate data — use plates to open gates and garages.</p>
          </div>
        </div>

        <!-- wide: audio analytics -->
        <div class="bn-card bn-w2">
          <div class="bn-visual">
            <img src="/images/services/audio.png" alt="Audio analytics" class="bn-img" />
            <span class="bn-vfc bn-vfc-a"></span><span class="bn-vfc bn-vfc-b"></span>
          </div>
          <div class="bn-body">
            <h3 class="bn-title">Audio analytics</h3>
            <p class="bn-desc">Detect aggression, glass break, and other sound events the cameras alone would miss.</p>
          </div>
        </div>

      </div>

      <div class="bn-cta fade-up">
        <div class="svc-tags">
          <span class="svc-tag">AXIS Certified</span>
          <span class="svc-tag">Milestone MCBP</span>
          <span class="svc-tag">Thermal &amp; Radar</span>
        </div>
        <a href="/contact" class="svc-inline-cta">
          Request a surveillance assessment
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </section>


  <!-- ── 02 Access Control ── -->
  <section id="access-control" class="svc-section svc-access">
    <div class="svc-num" aria-hidden="true">02</div>
    <div class="page-container">
      <div class="ac-split fade-up">

        <!-- LEFT: heading + preview -->
        <div class="ac-left">
          <span class="ac-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.4"/></svg>
            Access Control &amp; Badge Access
          </span>
          <h2 class="ac-h2">The right people in. Everyone else out.</h2>
          <p class="ac-lead">Control exactly who comes in, through which doors, and at which times — with a log of every attempt for review and audit. Hover a control to see it in place.</p>
          <p class="ac-fips">For government facilities, we're experienced with <b>FIPS 201</b> and <b>PIV</b> card access control requirements.</p>

          <div class="ac-preview" id="ac-preview">
            <div class="ac-slide ac-slide--active" data-i="0">
              <img src="/images/wwd-access.png" alt="Badge access" class="ac-slide-img" />
              <div class="ac-fallback">
                <svg class="ac-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="11" r="2.2"/><path d="M5.6 16.2c.5-1.5 1.6-2.2 2.9-2.2s2.4.7 2.9 2.2"/><path d="M15 9h4M15 12h4M15 15h2"/></svg>
              </div>
            </div>
            <div class="ac-slide" data-i="1">
              <div class="ac-fallback">
                <svg class="ac-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4a7 7 0 0 0-7 7v3M19 11a7 7 0 0 0-3-5.7M8 20c-.6-1.4-1-3-1-5a5 5 0 0 1 10 0c0 .7 0 1.4-.1 2M12 11v4M15.5 19.5c.3-1 .5-2 .5-3"/></svg>
              </div>
            </div>
            <div class="ac-slide" data-i="2">
              <div class="ac-fallback">
                <svg class="ac-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11V6a1.5 1.5 0 0 1 3 0v4M12 10V5a1.5 1.5 0 0 1 3 0v5M15 10.5V7a1.5 1.5 0 0 1 3 0v6a6 6 0 0 1-6 6h-1.5a5 5 0 0 1-3.6-1.6L4 13.5a1.6 1.6 0 0 1 2.4-2.1L9 13"/></svg>
              </div>
            </div>
            <div class="ac-slide" data-i="3">
              <div class="ac-fallback">
                <svg class="ac-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="2"/><circle cx="12" cy="8" r="2"/><path d="M9 13h6M9 16h6"/></svg>
              </div>
            </div>
            <div class="ac-slide" data-i="4">
              <div class="ac-fallback">
                <svg class="ac-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V6l7-3 7 3v15"/><path d="M4 21h16"/><path d="M8 9h.01M11 9h.01M8 13h.01M11 13h.01M8 17h3"/></svg>
              </div>
            </div>
            <div class="ac-slide" data-i="5">
              <img src="/images/badge-hero.png" alt="Vehicle & perimeter access" class="ac-slide-img" />
              <div class="ac-fallback">
                <svg class="ac-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9h11v7H2z"/><path d="M13 12h4l3 2v2h-7"/><circle cx="6.5" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/><path d="M20 4v6M20 4h-3"/></svg>
              </div>
            </div>
          </div>

          <div class="svc-tags" style="margin-top:28px">
            <span class="svc-tag">FIPS 201</span>
            <span class="svc-tag">PIV Experienced</span>
            <span class="svc-tag">ASSA ABLOY</span>
          </div>
          <a href="/contact" class="svc-inline-cta" style="margin-top:20px;display:inline-flex">
            Discuss your access control needs
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- RIGHT: hover list -->
        <div class="ac-list" id="ac-list">
          <div class="ac-item ac-item--active" data-i="0">
            <span class="ac-idx">01</span>
            <div class="ac-txt"><h4>Badge access &amp; smart cards</h4><p>Role-based permissions, time-of-day rules, and a full audit trail.</p></div>
            <span class="ac-arrow">→</span>
          </div>
          <div class="ac-item" data-i="1">
            <span class="ac-idx">02</span>
            <div class="ac-txt"><h4>Biometrics &amp; two-factor</h4><p>High-security entry for your most sensitive areas.</p></div>
            <span class="ac-arrow">→</span>
          </div>
          <div class="ac-item" data-i="2">
            <span class="ac-idx">03</span>
            <div class="ac-txt"><h4>Touch-free entry</h4><p>Low-energy operators, wave-to-open switches, and electric strikes.</p></div>
            <span class="ac-arrow">→</span>
          </div>
          <div class="ac-item" data-i="3">
            <span class="ac-idx">04</span>
            <div class="ac-txt"><h4>Intercom systems</h4><p>See and speak with visitors before unlocking the door.</p></div>
            <span class="ac-arrow">→</span>
          </div>
          <div class="ac-item" data-i="4">
            <span class="ac-idx">05</span>
            <div class="ac-txt"><h4>Multi-tenant access</h4><p>Tenants buzz in guests from their own phones — Android or iPhone.</p></div>
            <span class="ac-arrow">→</span>
          </div>
          <div class="ac-item" data-i="5">
            <span class="ac-idx">06</span>
            <div class="ac-txt"><h4>Vehicle &amp; perimeter access</h4><p>Gates tied to credentials or plates, with radar and sound detection.</p></div>
            <span class="ac-arrow">→</span>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ── 03 Alarms & Fire ── -->
  <section id="alarms" class="svc-section svc-fire">
    <div class="svc-num" aria-hidden="true">03</div>
    <div class="page-container">

      <div class="al-head fade-up">
        <div class="al-head-left">
          <span class="al-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
            Alarms, Monitoring &amp; Fire
          </span>
          <h2 class="al-h2">Protection that never clocks out.</h2>
        </div>
        <p class="al-sub">Intrusion, fire, and emergency signals all route to one place — full-time monitoring with 24/7 incident response.</p>
      </div>

      <div class="al-diagram fade-up">
        <svg viewBox="0 0 900 480" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Signals routing to 24/7 monitoring">
          <!-- traces background -->
          <g>
            <path class="al-trace-bg" d="M210 80 H300 V214 H372"></path>
            <path class="al-trace-flow al-d1" d="M210 80 H300 V214 H372"></path>
            <path class="al-trace-bg" d="M185 170 H295 V230 H372"></path>
            <path class="al-trace-flow al-d2" d="M185 170 H295 V230 H372"></path>
            <path class="al-trace-bg" d="M175 300 H300 V252 H372"></path>
            <path class="al-trace-flow al-d3" d="M175 300 H300 V252 H372"></path>
            <path class="al-trace-bg" d="M210 395 H310 V268 H372"></path>
            <path class="al-trace-flow al-d4" d="M210 395 H310 V268 H372"></path>
            <path class="al-trace-bg" d="M690 110 H600 V216 H528"></path>
            <path class="al-trace-flow al-d5" d="M690 110 H600 V216 H528"></path>
            <path class="al-trace-bg" d="M700 240 H600 V240 H528"></path>
            <path class="al-trace-flow al-d6" d="M700 240 H600 V240 H528"></path>
            <path class="al-trace-bg" d="M690 375 H600 V266 H528"></path>
            <path class="al-trace-flow al-d7" d="M690 375 H600 V266 H528"></path>
          </g>

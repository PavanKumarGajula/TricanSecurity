    }


    /* ─────────────────────────────────────────
       BENTO GRID (surveillance section)
    ───────────────────────────────────────── */
    .bn-head {
      display: flex;
      align-items: flex-end;
      gap: 48px;
      margin-bottom: clamp(44px, 5vw, 60px);
    }
    .bn-head-left {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .bn-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--color-surface-1);
      border: 1px solid var(--color-hairline);
      border-radius: 100px;
      padding: 8px 15px;
      font-family: var(--font-body);
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      width: fit-content;
    }
    .bn-pill--surv { color: var(--color-blue-400); }
    .bn-h2 {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(30px, 4.4vw, 56px);
      color: var(--color-ink);
      line-height: 1.06;
      letter-spacing: -0.025em;
    }
    .bn-sub {
      flex: 1;
      font-size: clamp(15px, 1.6vw, 17px);
      color: var(--color-ink-muted);
      line-height: 1.7;
      max-width: 44ch;
      padding-bottom: 6px;
    }
    @media (max-width: 720px) {
      .bn-head { flex-direction: column; align-items: flex-start; gap: 16px; }
      .bn-sub { max-width: 100%; padding-bottom: 0; }
    }

    /* grid */
    .bn-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    .bn-card {
      grid-column: span 1;
      display: flex;
      flex-direction: column;
      background: var(--color-surface-1);
      border: 1px solid var(--color-hairline);
      border-radius: 18px;
      overflow: hidden;
      box-shadow: var(--shadow-card);
      transition: border-color .2s ease, transform .2s ease;
    }
    .bn-card:hover { border-color: #363636; transform: translateY(-3px); }
    .bn-w2 { grid-column: span 2; }

    /* visual zone */
    .bn-visual {
      position: relative;
      height: 200px;
      overflow: hidden;
      background: #101012;
    }
    .bn-img {
      position: absolute;
      inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }
    .bn-vfc {
      position: absolute;
      z-index: 2;
      width: 13px; height: 13px;
      border: 1.5px solid var(--color-ink-muted);
      opacity: .38;
    }
    .bn-vfc-a { top: 14px; left: 14px; border-right: none; border-bottom: none; }
    .bn-vfc-b { bottom: 14px; right: 14px; border-left: none; border-top: none; }

    /* body */
    .bn-body { padding: 22px 24px 26px; min-height: 104px; }
    .bn-title {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 17px;
      color: var(--color-ink);
      letter-spacing: -0.15px;
      margin-bottom: 8px;
    }
    .bn-desc {
      font-family: var(--font-body);
      font-size: 13.5px;
      color: var(--color-ink-muted);
      line-height: 1.6;
    }

    /* cert tags + cta row below bento */
    .bn-cta {
      display: flex;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
      margin-top: 32px;
    }

    /* responsive */
    @media (max-width: 880px) {
      .bn-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .bn-grid { grid-template-columns: 1fr; }
      .bn-card, .bn-w2 { grid-column: span 1; }
      .bn-visual { height: 180px; }
      .bn-body { min-height: 0; }
    }


    /* ─────────────────────────────────────────
       ACCESS CONTROL — hover preview layout
    ───────────────────────────────────────── */
    .ac-split {
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: clamp(36px, 5vw, 68px);
      align-items: start;
    }

    /* pill */
    .ac-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--color-surface-1);
      border: 1px solid var(--color-hairline);
      border-radius: 100px;
      padding: 8px 15px;
      font-family: var(--font-body);
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--color-success-400);
      margin-bottom: 22px;
    }

    /* heading */
    .ac-h2 {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(28px, 3.6vw, 46px);
      color: var(--color-ink);
      line-height: 1.08;
      letter-spacing: -0.025em;
      margin-bottom: 18px;
    }
    .ac-lead {
      font-size: 15.5px;
      color: var(--color-ink-muted);
      max-width: 46ch;
      line-height: 1.65;
    }
    .ac-fips {
      font-size: 13px;
      color: var(--color-ink-muted);
      margin-top: 14px;
      line-height: 1.6;
    }
    .ac-fips b { color: var(--color-ink); font-weight: 500; }

    /* preview image box */
    .ac-preview {
      position: relative;
      aspect-ratio: 4 / 3;
      margin-top: 28px;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid var(--color-hairline);
      background: #101012;
      box-shadow: var(--shadow-card);
    }
    .ac-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity .4s ease;
    }
    .ac-slide--active { opacity: 1; }
    .ac-slide-img {
      position: absolute;
      inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      z-index: 2;
    }
    .ac-fallback {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .ac-glyph { width: 46px; height: 46px; color: #3b3b3b; }

    /* hover list */
    .ac-list { display: flex; flex-direction: column; }
    .ac-item {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 18px;
      padding: 20px 18px 20px 20px;
      border-bottom: 1px solid var(--color-hairline-soft);
      cursor: pointer;
      transition: background .2s ease;
      border-radius: 10px;
    }
    .ac-item:first-child { border-top: 1px solid var(--color-hairline-soft); }
    .ac-item::before {
      content: "";
      position: absolute;
      left: 0; top: 50%;
      transform: translateY(-50%);
      width: 2px; height: 0;
      background: var(--color-success-400);
      transition: height .25s ease;
      border-radius: 2px;
    }
    .ac-idx {
      font-family: var(--font-body);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1px;
      color: var(--color-ink-muted);
      padding-top: 3px;
      transition: color .2s ease;
      flex-shrink: 0;
    }
    .ac-txt h4 {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 16.5px;
      color: var(--color-ink-muted);
      letter-spacing: -0.1px;
      margin-bottom: 4px;
      transition: color .2s ease;
    }
    .ac-txt p {
      font-family: var(--font-body);
      font-size: 13px;
      color: var(--color-ink-muted);
      max-width: 42ch;
      line-height: 1.55;
    }
    .ac-arrow {
      margin-left: auto;
      align-self: center;
      color: var(--color-ink-muted);
      opacity: 0;
      transform: translateX(-6px);
      transition: opacity .2s ease, transform .2s ease, color .2s ease;
      flex-shrink: 0;
    }
    .ac-item:hover,
    .ac-item--active { background: var(--color-surface-1); }
    .ac-item:hover::before,
    .ac-item--active::before { height: 62%; }
    .ac-item:hover .ac-idx,
    .ac-item--active .ac-idx { color: var(--color-success-400); }
    .ac-item:hover .ac-txt h4,
    .ac-item--active .ac-txt h4 { color: var(--color-ink); }
    .ac-item:hover .ac-arrow,
    .ac-item--active .ac-arrow { opacity: 1; transform: translateX(0); color: var(--color-success-400); }

    @media (max-width: 880px) {
      .ac-split { grid-template-columns: 1fr; gap: 28px; }
      .ac-preview { aspect-ratio: 16 / 10; }
      .ac-arrow { display: none; }
    }


    /* ─────────────────────────────────────────
       ALARMS & FIRE — signal diagram
    ───────────────────────────────────────── */
    .al-head {
      display: flex;
      align-items: flex-end;
      gap: 48px;
      margin-bottom: clamp(40px, 5vw, 56px);
    }
    .al-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--color-surface-1);
      border: 1px solid var(--color-hairline);
      border-radius: 100px;
      padding: 8px 15px;
      font-family: var(--font-body);
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--color-error-400);
      width: fit-content;
    }
    .al-head-left {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .al-h2 {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(30px, 4.4vw, 52px);
      color: var(--color-ink);
      line-height: 1.06;
      letter-spacing: -0.025em;
    }
    .al-sub {
      flex: 1;
      font-size: clamp(15px, 1.6vw, 17px);
      color: var(--color-ink-muted);
      max-width: 44ch;
      line-height: 1.7;
      padding-bottom: 6px;
    }

    /* diagram */
    .al-diagram {
      overflow-x: auto;
      margin-bottom: clamp(32px, 4vw, 48px);
    }
    .al-diagram svg {
      display: block;
      width: 100%;
      min-width: 700px;
      max-width: 1040px;
      height: auto;
      margin: 0 auto;
    }
    .al-trace-bg  { stroke: var(--color-hairline); stroke-width: 1.8; fill: none; }
    .al-trace-flow {
      stroke: var(--color-blue-400);
      stroke-width: 1.8;
      fill: none;
      stroke-dasharray: 40 420;
      stroke-dashoffset: 460;
      filter: drop-shadow(0 0 5px rgba(0,153,255,.55));
      animation: al-flow 3.2s cubic-bezier(.5,0,.9,1) infinite;
    }
    .al-d1 { animation-delay: 0s; }
    .al-d2 { animation-delay: .4s; }
    .al-d3 { animation-delay: .8s; }
    .al-d4 { animation-delay: 1.2s; }
    .al-d5 { animation-delay: .2s; }
    .al-d6 { animation-delay: .6s; }
    .al-d7 { animation-delay: 1.0s; }
    @keyframes al-flow { to { stroke-dashoffset: 0; } }

    .al-chip-ring {
      animation: al-pulse 2.6s ease-in-out infinite;
      transform-origin: 450px 240px;
    }
    @keyframes al-pulse { 0%,100% { opacity: .35; } 50% { opacity: .9; } }

    .al-node     { fill: var(--color-blue-400); }
    .al-lbl-name { font-family: var(--font-body); font-weight: 600; font-size: 15px; fill: var(--color-ink); }
    .al-lbl-sub  { font-family: var(--font-body); font-weight: 500; font-size: 11.5px; letter-spacing: .4px; fill: var(--color-ink-muted); text-transform: uppercase; }
    .al-chip-num { font-family: var(--font-display); font-weight: 600; font-size: 30px; fill: var(--color-ink); }
    .al-chip-cap { font-family: var(--font-body); font-weight: 600; font-size: 11px; letter-spacing: 2px; fill: var(--color-ink-muted); }

    /* note row */
    .al-note {
      display: flex;
      align-items: center;
      gap: 32px;
      flex-wrap: wrap;
    }
    .al-note-p {
      font-family: var(--font-body);
      font-size: 13px;
      color: var(--color-ink-muted);
      line-height: 1.65;
      max-width: 58ch;
      flex: 1;
    }
    .al-note-p b { color: var(--color-ink); font-weight: 500; }

    @media (max-width: 720px) {
      .al-head { flex-direction: column; align-items: flex-start; gap: 16px; }
      .al-note { flex-direction: column; align-items: flex-start; gap: 16px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .al-trace-flow { animation: none; stroke-dashoffset: 0; }
      .al-chip-ring  { animation: none; }
    }


    /* ─────────────────────────────────────────
       04 NETWORK INFRASTRUCTURE
    ───────────────────────────────────────── */
    .nw-head {
      display: flex;
      align-items: flex-end;
      gap: 48px;
      margin-bottom: 40px;
    }
    .nw-head-left {
      display: flex;
      flex-direction: column;
      gap: 16px;
      flex-shrink: 0;
    }
    .nw-pill {
      font-family: var(--font-body);
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: #a78bfa;
      margin: 0;
    }
    .nw-h2 {
      font-family: var(--font-display);
      font-size: clamp(26px, 4vw, 40px);
      font-weight: 700;
      color: var(--color-ink);
      line-height: 1.1;
      margin: 0;
      max-width: 16ch;
    }
    .nw-subhead {
      font-family: var(--font-body);
      font-size: 15px;
      color: var(--color-ink-muted);
      line-height: 1.65;
      max-width: 46ch;
      flex: 1;
      margin: 0;
    }

    /* bento grid */
    .nw-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }
    .nw-tile {
      background: var(--color-surface-1);
      border-radius: 12px;
      padding: 28px;
      box-shadow: var(--shadow-card);
      position: relative;
      overflow: hidden;
    }
    .nw-tile--a {
      grid-column: span 2;
      grid-row: span 2;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 32px;
      min-height: 320px;
      background: #130f23;
    }
    .nw-tile--b { grid-column: span 2; }
    .nw-tile--c { grid-column: span 1; }
    .nw-tile--d { grid-column: span 1; }
    .nw-tile--e {
      grid-column: span 4;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      background: #1a1226;
      padding: 28px 36px;
    }

    /* watermark */
    .nw-watermark {
      position: absolute;
      top: 0; right: 0;
      width: 60%;
      height: 100%;
      opacity: 0.08;
      pointer-events: none;
    }
    .nw-tile-body { position: relative; z-index: 1; }

    /* chips */
    .nw-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
    .nw-chip {
      font-family: var(--font-body);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #a78bfa;
      border: 1px solid rgba(167, 139, 250, 0.3);
      border-radius: 4px;
      padding: 3px 8px;
    }

    /* tile text */
    .nw-tile-h3 {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 700;
      color: var(--color-ink);
      margin: 0 0 10px;
      line-height: 1.2;
    }
    .nw-tile--a .nw-tile-h3 { font-size: 26px; }
    .nw-tile-p {
      font-family: var(--font-body);
      font-size: 13.5px;
      color: var(--color-ink-muted);
      line-height: 1.6;
      margin: 0 0 20px;
    }
    .nw-tile--b .nw-tile-p,
    .nw-tile--c .nw-tile-p,
    .nw-tile--d .nw-tile-p { margin-bottom: 0; }

    .nw-cta {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 600;
      color: #a78bfa;
      text-decoration: none;
      transition: gap 200ms ease;
    }
    .nw-cta:hover { gap: 11px; }

    /* case study banner */
    .nw-case-body { flex: 1; }
    .nw-case-label {
      font-family: var(--font-body);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: #a78bfa;
      margin: 0 0 8px;
    }
    .nw-case-h3 {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 700;
      color: var(--color-ink);
      margin: 0 0 8px;
    }
    .nw-case-p {
      font-family: var(--font-body);
      font-size: 13.5px;
      color: var(--color-ink-muted);
      line-height: 1.55;
      margin: 0;
      max-width: 60ch;
    }
    .nw-case-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 600;
      color: #a78bfa;
      text-decoration: none;
      flex-shrink: 0;
      transition: gap 200ms ease;
    }
    .nw-case-link:hover { gap: 12px; }

    @media (max-width: 900px) {
      .nw-grid { grid-template-columns: repeat(2, 1fr); }
      .nw-tile--a { grid-column: span 2; grid-row: span 1; min-height: 260px; }
      .nw-tile--b { grid-column: span 2; }
      .nw-tile--c,
      .nw-tile--d { grid-column: span 1; }
      .nw-tile--e { grid-column: span 2; flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 600px) {
      .nw-head { flex-direction: column; align-items: flex-start; gap: 16px; }
      .nw-grid { grid-template-columns: 1fr; }
      .nw-tile--a,
      .nw-tile--b,
      .nw-tile--c,
      .nw-tile--d,
      .nw-tile--e { grid-column: span 1; grid-row: span 1; }
    }


    /* ─────────────────────────────────────────
       SERVICES STICKY NAV
    ───────────────────────────────────────── */
    .svc-nav {
      position: sticky;
      top: 60px;
      z-index: 20;
      background: rgba(9, 9, 9, 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }
    .svc-nav-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 32px;
      display: flex;
      align-items: center;
      gap: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .svc-nav-inner::-webkit-scrollbar { display: none; }
    .svc-nav-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.3px;
      color: var(--color-ink-muted);
      text-decoration: none;
      padding: 14px 20px;
      white-space: nowrap;
      border-bottom: 2px solid transparent;
      transition: color 0.2s ease, border-color 0.2s ease;
      flex-shrink: 0;
    }
    .svc-nav-link:hover { color: var(--color-ink); }
    .svc-nav-link.is-active {
      color: var(--color-blue-400);
      border-bottom-color: var(--color-blue-400);
    }
    .svc-nav-link svg { opacity: 0.6; flex-shrink: 0; }
    .svc-nav-link.is-active svg { opacity: 1; }
    .svc-nav-sep { display: none; }
    @media (max-width: 640px) {
      .svc-nav-inner { padding: 0 16px; }
      .svc-nav-link  { padding: 12px 14px; font-size: 11px; }
    }


    /* ─────────────────────────────────────────
       SERVICE SECTIONS — BASE
    ───────────────────────────────────────── */
    .svc-section {
      position: relative;
      padding: 96px 0;
      overflow: hidden;
    }

    /* Big watermark number */
    .svc-num {
      position: absolute;
      right: -10px;
      bottom: -20px;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(120px, 18vw, 220px);
      letter-spacing: -10px;
      line-height: 1;
      user-select: none;
      pointer-events: none;
      color: var(--color-ink);
      opacity: 0.025;
    }

    /* Two-column layout */
    .svc-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: start;
    }
    /* Flipped variant — right column first on desktop (visually) */
    .svc-layout--flip { }
    @media (min-width: 1024px) {
      .svc-layout--flip > .svc-right { order: -1; }
    }

    /* Left column */
    .svc-eyebrow {
      font-family: var(--font-body);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      display: block;
      margin-bottom: 16px;
    }
    .svc-surv    .svc-eyebrow { color: var(--color-blue-400); }
    .svc-access  .svc-eyebrow { color: var(--color-success-400); }
    .svc-fire    .svc-eyebrow { color: var(--color-error-400); }
    .svc-network .svc-eyebrow { color: var(--color-warning-400); }
    .svc-rentals .svc-eyebrow { color: var(--color-blue-300); }

    .svc-heading {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(26px, 3vw, 42px);
      letter-spacing: -1px;
      color: var(--color-ink);
      line-height: 1.1;
      margin-bottom: 20px;
    }
    .svc-heading--wide { max-width: 520px; }
    .svc-lead {
      font-family: var(--font-body);
      font-size: 15px;
      color: var(--color-ink-muted);
      line-height: 1.75;
      margin-bottom: 12px;
    }
    .svc-body {
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--color-ink-muted);
      line-height: 1.7;
      opacity: 0.8;
      margin-bottom: 28px;
    }

    /* Cert tags */
    .svc-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 28px;

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Security Services — Trican Security Inc."
  description="Surveillance, access control, alarms, fire alarms, network infrastructure, and mobile trailer rentals for businesses and government agencies across Maryland."
  padTop={false}
>

  <!-- ── Hero ── -->
  <section class="svc-hero">

    <div class="svc-hero-content">
      <span class="svc-kicker">
        <span class="svc-kicker-dot" aria-hidden="true"></span>
        Every layer of protection. One team.
        <span class="svc-kicker-dot" aria-hidden="true"></span>
      </span>
      <h1 class="svc-hero-h1">Cameras, badges, alarms, fire, network. One team builds it all.</h1>
      <p class="svc-hero-sub"><b>Locally owned and Maryland-based.</b> One team for surveillance, access, alarms, fire, and network — across Maryland, the Baltimore–Washington corridor, and Virginia.</p>
      <div class="svc-hero-actions">
        <a class="btn-primary" href="/contact">Get a Free Assessment</a>
        <a class="btn-ghost" href="tel:4106457121">Call 410-645-7121</a>
      </div>
    </div>

    <div class="svc-strip-wrap">
      <div class="svc-strip-label">
        <span class="svc-strip-ln" aria-hidden="true"></span>
        <span class="svc-strip-t">Selected work · Maryland &amp; the DC region</span>
        <span class="svc-strip-ln" aria-hidden="true"></span>
      </div>
      <div class="svc-strip" aria-hidden="true">
        <div class="svc-track">
          <!-- set 1 -->
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/wwd-surveillance.jpg" alt="" class="svc-wimg" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Evangel Cathedral · Smart card + video</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/wearable_pendant.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Queen Anne's County · Mobile health units</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/network-hero.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">ReLink Medical · Network buildout</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/mobile_surveillance.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Mobile surveillance trailer</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/wwd-access.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Badge access &amp; smart cards</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/alarm-hero.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Fire alarm systems · NICET certified</span></div>
          </div>
          <!-- set 2 (duplicate for seamless loop) -->
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/wwd-surveillance.jpg" alt="" class="svc-wimg" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Evangel Cathedral · Smart card + video</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/wearable_pendant.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Queen Anne's County · Mobile health units</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/network-hero.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">ReLink Medical · Network buildout</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/mobile_surveillance.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Mobile surveillance trailer</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/wwd-access.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Badge access &amp; smart cards</span></div>
          </div>
          <div class="svc-wcard">
            <div class="svc-wthumb">
              <span class="svc-vfc svc-vfc-a"></span><span class="svc-vfc svc-vfc-b"></span>
              <img src="/images/alarm-hero.png" alt="" class="svc-wimg svc-wimg--contain" />
            </div>
            <div class="svc-wfoot"><span class="svc-wonline"></span><span class="svc-wcap">Fire alarm systems · NICET certified</span></div>
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- ── Sticky Services Nav ── -->
  <nav class="svc-nav" id="svc-nav" aria-label="Jump to service">
    <div class="svc-nav-inner">
      <a href="#surveillance"  class="svc-nav-link" data-target="surveillance">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="13" height="9" rx="2"/><path d="M15 9l7-3v9l-7-3"/></svg>
        Surveillance
      </a>
      <span class="svc-nav-sep" aria-hidden="true"></span>
      <a href="#access-control" class="svc-nav-link" data-target="access-control">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="12" height="18" rx="2"/><circle cx="10" cy="9" r="2"/><path d="M7 17c.6-2 5.4-2 6 0"/></svg>
        Access Control
      </a>
      <span class="svc-nav-sep" aria-hidden="true"></span>
      <a href="#alarms" class="svc-nav-link" data-target="alarms">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        Alarms &amp; Fire
      </a>
      <span class="svc-nav-sep" aria-hidden="true"></span>
      <a href="#network" class="svc-nav-link" data-target="network">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><circle cx="7" cy="7.5" r=".7"/><circle cx="7" cy="16.5" r=".7"/></svg>
        Network
      </a>
      <span class="svc-nav-sep" aria-hidden="true"></span>
      <a href="#rentals" class="svc-nav-link" data-target="rentals">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="15" height="9" rx="1.5"/><circle cx="7" cy="18.5" r="1.8"/><circle cx="14" cy="18.5" r="1.8"/><path d="M17 11h5"/></svg>
        Commercial &amp; Rentals
      </a>
    </div>
  </nav>


  <!-- ── 01 Surveillance ── -->
  <section id="surveillance" class="svc-section svc-surv">
    <div class="svc-num" aria-hidden="true">01</div>
    <div class="page-container">
      <div class="svc-layout">

        <div class="svc-left fade-up">
          <p class="svc-eyebrow">01 — Surveillance</p>
          <h2 class="svc-heading">See everything that matters. From anywhere.</h2>
          <p class="svc-lead">Video surveillance is the most effective tool there is for reducing property loss and damage — but only if the cameras are right for the job. We partner with top camera manufacturers and design every solution from scratch.</p>
          <p class="svc-body">Thermal cameras and radar/sound detection for perimeter protection, discreet domes for retail, network or analog — whatever your situation calls for. It starts with a full assessment of your site.</p>
          <div class="svc-tags">
            <span class="svc-tag">AXIS Certified</span>
            <span class="svc-tag">Milestone MCBP</span>
            <span class="svc-tag">Thermal &amp; Radar</span>
          </div>
          <a href="/contact" class="svc-inline-cta">
            Request a surveillance assessment
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="svc-right fade-up">
          <p class="svc-feat-label">Video Analytics</p>
          <ul class="svc-feat-list">
            {[
              ['Auto tracking',             'Cameras that follow movement across parking lots and open spaces'],
              ['Heat mapping',              'See traffic patterns based on visitor density and duration'],
              ['People counting',           'Know exactly how many people enter and exit any defined area'],
              ['License plate recognition', 'Capture searchable plate data — use plates to open gates and garages'],
              ['Audio analytics',           'Detect aggression, glass break, and other sound events'],
            ].map(([title, desc]) => (
              <li class="svc-feat">
                <span class="svc-feat-dot" aria-hidden="true"></span>
                <div>
                  <p class="svc-feat-title">{title}</p>
                  <p class="svc-feat-body">{desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>


  <!-- ── 02 Access Control ── -->
  <section id="access-control" class="svc-section svc-access">
    <div class="svc-num" aria-hidden="true">02</div>
    <div class="page-container">
      <div class="svc-layout svc-layout--flip">

        <div class="svc-right fade-up">
          <p class="svc-feat-label">What We Install</p>
          <ul class="svc-feat-list">
            {[
              ['Badge access & smart cards',  'Employee badges with role-based permissions, time-of-day rules, and full audit trail; deactivate a lost badge in seconds'],
              ['Biometrics & two-factor auth', 'High security entry for sensitive areas'],
              ['Touch-free entry',            'Low energy door operators, wave-to-open switches, and electric strikes'],
              ['Intercom systems',            'See and speak with visitors before unlocking the door, from anywhere'],
              ['Multi-tenant access',         'Outdoor rated intercoms — tenants buzz in guests from their own phone'],
              ['Vehicle & perimeter access',  'Automatic gates tied to credentials or license plates, with radar and sound detection'],
            ].map(([title, desc]) => (
              <li class="svc-feat">
                <span class="svc-feat-dot" aria-hidden="true"></span>
                <div>
                  <p class="svc-feat-title">{title}</p>
                  <p class="svc-feat-body">{desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="svc-left fade-up">
          <p class="svc-eyebrow">02 — Access Control</p>
          <h2 class="svc-heading">The right people in. Everyone else out.</h2>
          <p class="svc-lead">Control exactly who can enter your property, through which doors, at which times — and keep a log of every attempt for review and audit.</p>
          <p class="svc-body">For government facilities, we're experienced with FIPS 201 and PIV card access control requirements — the compliance standard for federal sites.</p>
          <div class="svc-tags">
            <span class="svc-tag">FIPS 201</span>
            <span class="svc-tag">PIV Experienced</span>
            <span class="svc-tag">ASSA ABLOY</span>
          </div>
          <a href="/contact" class="svc-inline-cta">
            Discuss your access control needs
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

      </div>
    </div>
  </section>


  <!-- ── 03 Alarms & Fire ── -->
  <section id="alarms" class="svc-section svc-fire">
    <div class="svc-num" aria-hidden="true">03</div>
    <div class="page-container">
      <div class="svc-layout">

        <div class="svc-left fade-up">
          <p class="svc-eyebrow">03 — Alarms, Monitoring &amp; Fire</p>
          <h2 class="svc-heading">Protection that never clocks out.</h2>
          <p class="svc-lead">Intrusion alarm systems watch your space around the clock. We offer full-time monitoring with 24/7 incident response, so something happening at 3 a.m. doesn't wait until 9 a.m. to get handled.</p>
          <p class="svc-body">Fire alarm systems are designed, installed, and supported by NICET-certified technicians, including a Certified Fire Alarm Technician (CFAT) Level II. One team for security and fire — one point of accountability.</p>
          <div class="svc-tags">
            <span class="svc-tag">NICET Certified</span>
            <span class="svc-tag">CFAT Level II</span>
            <span class="svc-tag">Alarm.com</span>
          </div>
          <a href="/contact" class="svc-inline-cta">
            Get monitoring coverage
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="svc-right fade-up">
          <p class="svc-feat-label">Services Included</p>
          <ul class="svc-feat-list">
            {[
              ['Video-verified alarms',      "When a sensor trips, live camera footage confirms what's happening — cutting false alarms and speeding real response"],
              ['Remote monitoring & control', 'Arm, disarm, and check status from your mobile device via Alarm.com'],
              ['Real-time notifications',    'The moment something trips, you know'],
              ['24/7 incident response',     'Monitoring with full response — not just a call-back at 9 a.m.'],
              ['Personal emergency response',"Two-way voice and GPS — proven protecting Queen Anne's County health workers in the field"],
              ['NICET fire alarm systems',   'Design, installation, and ongoing support from certified technicians'],
            ].map(([title, desc]) => (
              <li class="svc-feat">
                <span class="svc-feat-dot" aria-hidden="true"></span>
                <div>
                  <p class="svc-feat-title">{title}</p>
                  <p class="svc-feat-body">{desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>


  <!-- ── 04 Network ── -->
  <section id="network" class="svc-section svc-network">
    <div class="svc-num" aria-hidden="true">04</div>
    <div class="page-container">
      <div class="svc-layout svc-layout--flip">

        <div class="svc-right fade-up">
          <p class="svc-feat-label">What We Build</p>
          <ul class="svc-feat-list">
            {[
              ['Structured cabling',        'BICSI TECH and Corning Fiber certified'],
              ['Network racks & equipment', 'Full equipment room buildout and management'],
              ['WiFi & wireless access',    'Coverage planning, WAP installation, and secure guest WiFi'],
              ['Network infrastructure',    'Design, upgrade, and Cisco certified configuration'],
            ].map(([title, desc]) => (
              <li class="svc-feat">
                <span class="svc-feat-dot" aria-hidden="true"></span>
                <div>
                  <p class="svc-feat-title">{title}</p>
                  <p class="svc-feat-body">{desc}</p>
                </div>
              </li>
            ))}
          </ul>

          <div class="svc-callout fade-up">
            <p class="svc-callout-label">Case Study</p>
            <p class="svc-callout-body">Complete buildout for ReLink Medical's new White Marsh warehouse — cabling, wireless access points, cameras, network rack, and cloud access control. All by one team.</p>
          </div>
        </div>

        <div class="svc-left fade-up">
          <p class="svc-eyebrow">04 — Network Infrastructure</p>
          <h2 class="svc-heading">The backbone behind every system.</h2>
          <p class="svc-lead">Every camera, badge reader, and alarm panel runs on your network — so we build that too. One contractor for security and infrastructure means no finger-pointing between vendors.</p>
          <p class="svc-body">We're BICSI TECH and Corning Fiber certified, and Cisco trained — so the infrastructure we put in is the right spec from day one.</p>
          <div class="svc-tags">
            <span class="svc-tag">BICSI TECH</span>
            <span class="svc-tag">Corning Fiber</span>
            <span class="svc-tag">Cisco Trained</span>
          </div>
          <a href="/contact" class="svc-inline-cta">
            Plan your network infrastructure
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

      </div>
    </div>
  </section>


  <!-- ── 05 Commercial & Rentals ── -->
  <section id="rentals" class="svc-section svc-rentals">
    <div class="svc-num" aria-hidden="true">05</div>
    <div class="page-container">

      <div class="svc-rentals-head fade-up">
        <p class="svc-eyebrow">05 — Commercial &amp; Rentals</p>
        <h2 class="svc-heading svc-heading--wide">Built for the way your business actually works.</h2>
      </div>

      <div class="svc-use-grid fade-up">
        {[
          { title: 'Office Space',          body: "Protect your people, equipment, and data. Badge access, cameras, and alarms — plus network and WiFi upgrades while we're at it." },
          { title: 'Retail',                body: 'Cover merchandise and registers, deter theft, and add secure guest WiFi your customers will appreciate.' },
          { title: 'Warehouse & Logistics', body: 'Watch deliveries and inventory, and cut liability exposure from personnel and equipment incidents.' },
          { title: 'Multi-Tenant',          body: 'Modern intercom systems let tenants grant access to guests from their phone — manage the whole property from your office.' },
        ].map(s => (
          <div class="svc-use-card">
            <h3 class="svc-use-title">{s.title}</h3>
            <p class="svc-use-body">{s.body}</p>
          </div>
        ))}
      </div>

      <div class="svc-trailer-wrap fade-up">
        <div class="svc-trailer-left">
          <div class="svc-trailer-badge">Solar Powered · Cellular · No Generator</div>
          <h3 class="svc-trailer-heading">Mobile Surveillance Trailers</h3>
          <p class="svc-trailer-body">Rugged, solar powered, and self contained. Delivered to your location and deployed in 10 minutes — no cords or generators required. Short and long term rentals available.</p>
          <a href="/contact" class="svc-inline-cta" style="margin-top:24px">
            Ask about trailer availability
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="svc-trailer-right">
          <ul class="svc-trailer-feats">
            {[
              'Live streaming & recorded playback over cellular',
              'Panoramic, zoom, thermal, and radar cameras',
              'Blue strobe warning light to deter intruders',
              'Runs indefinitely on sunlight',
              'Ideal for lay-down yards, construction sites, parking lots',
              'Short and long term rentals',
            ].map(f => (
              <li class="svc-trailer-feat">
                <span class="svc-feat-dot" aria-hidden="true"></span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="svc-temp-callout fade-up">
        <div class="svc-callout">
          <p class="svc-callout-label">Temporary Surveillance Units</p>
          <p class="svc-callout-body">Compact rental units with cellular connectivity, battery plus AC power, remote viewing and playback. Satisfies insurance requirements for continuous watch on sites with no or intermittent power.</p>
        </div>
      </div>

    </div>
  </section>


  <!-- ── Process ── -->
  <section class="svc-process-section">
    <div class="page-container">
      <div class="svc-process-head fade-up">
        <p class="eyebrow">How it works</p>
        <h2 class="svc-process-h2">Simple from start to finish.</h2>
      </div>
      <div class="svc-process-grid">
        {[
          {
            n: '01',
            title: 'Free Site Assessment',
            body: "We walk your property, listen to your concerns, and identify every vulnerability. No sales pitch — just a clear picture of what you're dealing with.",
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0112 2a8 8 0 018 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>`,
          },
          {
            n: '02',
            title: 'Tailored Design',
            body: "We build a solution specific to your space, budget, and risk profile — not a package off a shelf. You'll see exactly what you're getting before anything is ordered.",
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
          },
          {
            n: '03',
            title: 'Install & Ongoing Support',
            body: "Our certified technicians handle every layer — no subcontractors. After install, we're your single point of contact for service, monitoring, and upgrades.",
            icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/><path d="M12 6v6l4 2"/></svg>`,
          },
        ].map(step => (
          <div class="svc-step fade-up">
            <div class="svc-step-top">
              <div class="svc-step-icon" set:html={step.icon}></div>
